{
  "name": "@fonteia/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prerender.mjs",
    "build:check": "tsc -p tsconfig.json && vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run --passWithNoTests",
    "lint": "echo \"lint pending\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fonteia/ai": "workspace:*",
    "@fonteia/billing": "workspace:*",
    "@fonteia/domain": "workspace:*",
    "@fonteia/scoring": "workspace:*",
    "@fonteia/sources": "workspace:^",
    "@fontsource-variable/figtree": "^5.2.10",
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.3.0",
    "playwright": "^1.60.0",
    "typescript": "^5.7.3",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8"
  }
}
