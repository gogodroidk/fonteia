# =============================================================================
# .env.example — Fonte.ia / Olli
# Atualizado em: 2026-06-18
# =============================================================================
# Onde cada segredo VIVE em produção:
#   [Vault]         = Supabase Vault (vault.secrets) — lido via get_vault_secret()
#   [Edge Secret]   = Cloudflare Workers Secret (wrangler secret put) ou
#                     Supabase Edge Function Secret (supabase secrets set)
#   [Build Env]     = Variável de ambiente de build (Cloudflare Pages / CI)
#   [Local only]    = Nunca vai para produção; só .env local de dev
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# SUPABASE — frontend (build env)
# Em produção: Cloudflare Pages → Settings → Environment Variables
# [Build Env]
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://pwiuiihsyazghdsrpshg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# SUPABASE — backend / Edge Functions
# Em produção: supabase secrets set SERVICE_ROLE_KEY=...
# [Edge Secret] — NUNCA expor no bundle do frontend
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# IA — modelos de linguagem
# Em produção: Cloudflare Workers Secrets ou Supabase Edge Secrets
# Gemini usado para embeddings (text-embedding-004, dim=768).
# Anthropic usado para análise/geração de texto (Claude).
# [Edge Secret]
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# STRIPE — billing
# Em produção: Cloudflare Workers Secrets / Supabase Edge Secrets
# [Edge Secret]
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -----------------------------------------------------------------------------
# CRON / WORKER SECRETS
# Usados para autenticar chamadas de cron (Cloudflare Cron Triggers → Worker).
# Gere com: openssl rand -hex 32
# [Edge Secret]
# -----------------------------------------------------------------------------
INGEST_CRON_SECRET=
ALERTS_CRON_SECRET=
MIGRATE_SECRET=

# -----------------------------------------------------------------------------
# FONTES DE DADOS PÚBLICOS
# Portal da Transparência: https://portaldatransparencia.gov.br/api-de-dados
# DataJud (CNJ): https://www.cnj.jus.br/sistemas/datajud/api-publica/
# InfoSimples: https://infosimples.com/api (pago por consulta)
# Em produção: Supabase Vault (lido via get_vault_secret()) ou Edge Secret
# [Vault] ou [Edge Secret]
# -----------------------------------------------------------------------------
PORTAL_TRANSPARENCIA_TOKEN=
DATAJUD_API_KEY=
INFOSIMPLES_TOKEN=

# -----------------------------------------------------------------------------
# CLOUDFLARE — deploy e infra
# CF_API_TOKEN: token com permissões Pages + Workers + R2
# CF_ACCOUNT_ID: account ID do painel Cloudflare
# Em produção: CI/CD secrets (GitHub Actions ou equivalente)
# [Build Env / CI]
# -----------------------------------------------------------------------------
CF_API_TOKEN=
CF_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# DATABASE (local dev only — em produção use Supabase diretamente)
# [Local only]
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fonteia
DATABASE_SSL=false

# =============================================================================
# VARIÁVEIS REMOVIDAS (não use):
#   OPENAI_API_KEY      → substituído por GEMINI_API_KEY + ANTHROPIC_API_KEY
#   AI_MODEL=gpt-5-mini → modelo não existe; use Gemini/Claude explicitamente
#   REDIS_URL           → sem Redis; rate limiting via ai_rate_limits (Postgres)
#   OPENSEARCH_URL      → sem OpenSearch; busca vetorial via pgvector
#   MERCADO_PAGO_*      → removido; billing exclusivamente via Stripe
#   INLABS_*            → DOU via INLABS não implementado (roadmap)
#   SERPRO_*            → integração SERPRO não implementada (roadmap)
#   S3_*                → substituído por Cloudflare R2 (sem S3 compatível local)
# =============================================================================
